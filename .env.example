# Environment variables untuk FastAPI backend
# Salin file ini ke .env dan isi nilainya

# Groq API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model yang dipakai (default: llama-3.3-70b-versatile)
# Bisa juga: openai/gpt-oss-120b (jika tersedia di akun Groq kamu)
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CORS origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
